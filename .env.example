# ---------------------------------------------------------------------------
# FinTrack API - environment template
# Copy to .env for local development:  cp .env.example .env
# On Render/Railway/Fly set these through the host's environment UI instead -
# .env is git-ignored and never deployed.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database -------------------------------------------------------------
# Local Postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fintrack?schema=public"
# Supabase / Neon / Railway (note sslmode=require):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public&sslmode=require"

# --- Auth -----------------------------------------------------------------
# Generate a real one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-before-deploying"
JWT_EXPIRES_IN="1h"
BCRYPT_SALT_ROUNDS=10

# --- Security -------------------------------------------------------------
# Comma-separated list of allowed browser origins. "*" allows any origin and
# should only ever be used locally.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Rate limit applied to POST /auth/login only (not to normal CRUD traffic).
LOGIN_RATE_LIMIT=5
LOGIN_RATE_TTL_SECONDS=60

# Decimal places money is rounded to. Must match NUMERIC(12,2) in the schema.
MONEY_DECIMAL_PLACES=2
